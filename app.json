{
  "expo": {
    "name": "SkorLig",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "skorlig",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.skorlig",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f5229"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "extra": {
      "apiBase": "https://158.180.49.98.sslip.io",
      "adminUserIds": "demo1,xXhSFvM1SFYN3kUYAdMGRaUkPp53",
      "router": {},
      "eas": {
        "projectId": "1c06a877-40a7-4bb8-a3da-454d54ce5617"
      }
    },
    "plugins": [
      "expo-audio",
      "expo-router",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#f59e0b"
        }
      ]
    ],
    "icon": "assets/icon.png",
    "owner": "hucigo11"
  }
}
